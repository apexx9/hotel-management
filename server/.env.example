# =========================================================
# Hotel Management System — Server environment variables
# =========================================================
# Copy this file to `.env` and fill in values. Never commit `.env`.

# --- Database ---------------------------------------------------
# Full PostgreSQL connection string (e.g. Aiven / local Postgres).
DATABASE_URL=postgresql://user:password@host:port/database

# Connection pool tuning (slow remote databases benefit from sane limits).
# PG_POOL_MAX=20
# PG_CONNECT_TIMEOUT=10000
# PG_IDLE_TIMEOUT=30000

# --- Auth / tokens ----------------------------------------------
# Secret used to sign JWT access tokens. Use a long random value.
JWT_SECRET=change-me-to-a-long-random-string

# When "true", email-verified users are required.
# REQUIRE_EMAIL_VERIFICATION=false

# --- HTTP --------------------------------------------------------
# Port the API listens on.
# PORT=3001

# Comma-separated list of allowed CORS origins for the client.
# CLIENT_ORIGIN=http://localhost:3000,http://localhost:3002

# Public frontend origin, used to build links inside emails
# (invitation links, confirmation links).
# FRONTEND_URL=http://localhost:3000

# --- Brevo (email delivery) -----------------------------------
# This is the SINGLE platform email service that every hotel uses.
# No custom domain is required: verify a sender email address in
# Settings > Senders & IP (Brevo sends a confirmation code to it).
# Hotels can only customize the display name, reply-to email, logo,
# and colors in Settings > Hotel > "Email & Branding" (stored per
# hotel in the DB). Email is DISABLED (skips sends) until an API
# key is set here.
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxx
# BREVO_SMTP_KEY=                  # optional SMTP key (unused by the API client)
# SMTP_FROM=verified-sender@example.com
# SMTP_FROM_NAME=My Hotel